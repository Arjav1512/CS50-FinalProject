{
  "manifest_version": 3,
  "name": "Digital Diary",
  "version": "1.1.0",
  "description": "See where your time online goes: time per site and category, streaks, focus sessions and reports. Your data stays in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "trackingtabs.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui.html",
    "default_title": "Digital Diary",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html"
}
